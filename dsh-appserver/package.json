{
  "name": "dsh-appserver",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Codex app-server-shaped protocol adapter for DeepSeek Harness",
  "files": ["src", "bin", "cordis.patch.yml", "README.md", "DESIGN.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "src/cordis-plugin.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/cordis-plugin.js"
    },
    "./protocol": {
      "types": "./src/protocol.d.ts",
      "import": "./src/protocol.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.js.json",
    "docs:protocol": "node scripts/generate-protocol-docs.mjs",
    "smoke:projection-worker": "node scripts/smoke-projection-worker.mjs",
    "smoke:mobile-http": "node test/mobile-http.smoke.mjs",
    "test": "vitest run",
    "test:runtime-stdio": "node test/runtime-stdio.smoke.mjs",
    "test:runtime-http": "node test/runtime-http.smoke.mjs",
    "test:runtime-profile": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File test/runtime-profile.smoke.ps1",
    "test:runtime-jsonrpc": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File test/runtime-jsonrpc.smoke.ps1",
    "test:http-transport": "node test/http-transport.smoke.mjs",
    "test:models": "node test/models.smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
